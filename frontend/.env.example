# Empty public API URL uses the same-origin Next.js API proxy. This avoids
# third-party cookie restrictions in admin and supports local media URLs.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must exactly match the backend value.
REVALIDATE_SECRET=replace-with-a-shared-secret-at-least-32-characters
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
