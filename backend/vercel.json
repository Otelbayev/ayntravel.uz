{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run db:deploy && npm run db:seed:content && rm -f tsconfig.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-tokens",
      "schedule": "0 3 * * *"
    }
  ]
}
