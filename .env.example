# ─────────────────────────────────────────────────────────────
# AYN TRAVEL — muhit sozlamalari
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Ma'lumotlar bazasi ───────────────────────────────────────
DATABASE_URL=postgresql://ayn:ayn_local_password@localhost:5432/ayntravel?schema=public
POSTGRES_USER=ayn
POSTGRES_PASSWORD=ayn_local_password
POSTGRES_DB=ayntravel

# ── API ──────────────────────────────────────────────────────
PORT=4000
# Ikkalasi ham kamida 32 belgi. Yaratish: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_min_32_belgi_uzunlikdagi_maxfiy_kalit
JWT_REFRESH_SECRET=CHANGE_ME_boshqa_min_32_belgi_uzunlikdagi_kalit
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Vergul bilan ajratilgan ruxsat etilgan originlar
CORS_ORIGINS=http://localhost:3000
# Production'da: .ayntravel.uz (subdomenlar uchun)
# COOKIE_DOMAIN=

# ── Sayt ─────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
# Admin nashr qilganda Next.js keshini yangilash uchun umumiy sir
REVALIDATE_SECRET=CHANGE_ME_min_16_belgi

# ── Fayl saqlash ─────────────────────────────────────────────
# local — server diski (uploads/ papkasi)
# s3    — S3 / Cloudflare R2 / DigitalOcean Spaces
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
ASSET_BASE_URL=http://localhost:4000/uploads

# STORAGE_DRIVER=s3 bo'lganda:
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ayntravel
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Telegram (yangi lid xabarlari) ───────────────────────────
# 1) @BotFather da bot yarating → tokenni oling
# 2) Menejerlar guruhiga botni admin qilib qo'shing
# 3) Guruh chat_id sini oling (guruhda -100... bilan boshlanadi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Xavfsizlik ───────────────────────────────────────────────
# IP manzillarni hash qilish uchun tuz (xom IP hech qachon saqlanmaydi)
IP_HASH_SALT=CHANGE_ME_tasodifiy_satr

LOG_LEVEL=info

# ── Seed ─────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@ayntravel.uz
SEED_ADMIN_PASSWORD=AynTravel2026!

# ── Frontend (Next.js) ───────────────────────────────────────
# Brauzerdan ko'rinadigan API manzili
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server ichidan API manzili (bir serverda bo'lsa 127.0.0.1 tezroq)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analitika (ixtiyoriy)
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
# Qidiruv tizimlari tasdiqlash kodlari
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
